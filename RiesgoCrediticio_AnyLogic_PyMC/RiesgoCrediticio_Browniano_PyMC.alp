		<ActiveObjectClass>
			<Id>1890000000003</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[
// 1) Lectura opcional de PD individuales exportadas desde PyMC.
// La carpeta de ejecucion debe contener clientes_parametros.csv.
java.io.File archivoClientes = new java.io.File("clientes_parametros.csv");
if (archivoClientes.exists()) {
    try (java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(archivoClientes))) {
        String linea = br.readLine(); // cabecera id,ingreso_z,endeudamiento,p_mensual_mora
        while ((linea = br.readLine()) != null) {
            String[] v = linea.trim().split(",");
            if (v.length < 4) continue;
            int id = Integer.parseInt(v[0].trim());
            if (id < 0 || id >= clientes.size()) continue;
            cliente c = clientes.get(id);
            c.ingresoZ = Double.parseDouble(v[1].trim());
            c.deudaRelativa = Double.parseDouble(v[2].trim());
            c.pBase = Math.min(0.999, Math.max(0.00001, Double.parseDouble(v[3].trim())));
            c.onChange();
        }
        traceln("PD cargadas desde PyMC: " + clientes.size() + " clientes");
    } catch (Exception ex) {
        traceln("No se pudo leer clientes_parametros.csv: " + ex.getMessage());
    }
} else {
    traceln("Modo demostracion: sin clientes_parametros.csv; PD sinteticas.");
}
// 2) Lectura opcional del coeficiente gamma estimado en PyMC.
java.io.File archivoCoef = new java.io.File("coeficientes_pymc.csv");
if (archivoCoef.exists()) {
    try (java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(archivoCoef))) {
        br.readLine(); // parametro,valor
        String linea;
        while ((linea = br.readLine()) != null) {
            String[] v = linea.trim().split(",");
            if (v.length >= 2 && v[0].trim().equals("gamma")) {
                gamma = Double.parseDouble(v[1].trim());
            }
        }
        traceln("Gamma importada: " + gamma);
    } catch (Exception ex) {
        traceln("No se pudo leer coeficientes_pymc.csv: " + ex.getMessage());
    }
}
]]></StartupCode>
