			<Events>
				<Event>
					<Id>1890000001041</Id>
					<Name><![CDATA[actualizarBrowniano]]></Name>
					<X>40</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[0.25]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[4]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MONTH]]></Unit>
						</Rate>
						<Id>1889999989999</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1795651200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0.25]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.25]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[true]]></Condition>
					</Properties>
					<Action><![CDATA[
// Euler-Maruyama: dX = kappa (mu-X)dt + sigma dW, dW=sqrt(dt)*Z.
// Un mismo X_t afecta a los 100 clientes (choque economico comun).
double dt = pasoBrowniano;
estresEconomico += kappa * (mu - estresEconomico) * dt
                   + sigma * Math.sqrt(dt) * normal(1,0);
// Las tasas de transicion tipo Rate necesitan notificacion al cambiar X.
for (cliente c : clientes) c.onChange();
]]></Action>
				</Event>
			</Events>

