	<Name><![CDATA[RiesgoCrediticio_Browniano_PyMC]]></Name>
	<EngineVersion>6</EngineVersion>
	<JavaPackageName><![CDATA[riesgocrediticio_browniano_pymc]]></JavaPackageName>
