		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1890000000004</Id>
			<Name><![CDATA[cliente]]></Name>
			<StartupCode><![CDATA[
// Parametros de demostracion (NO estimados): PD mensual condicional a estar en mora.
// Un cliente con mayor endeudamiento tiene una PD mayor, ceteris paribus.
double z = -2.7 - 0.5 * ingresoZ + 1.4 * deudaRelativa;
pBase = 1.0 / (1.0 + Math.exp(-z));
]]></StartupCode>
